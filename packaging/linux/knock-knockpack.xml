<?xml version="1.0" encoding="UTF-8"?>
<!-- .knockpack: a Knock sprite pack (a zip). Opening one with Knock offers to add it. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-knockpack">
    <comment>Knock sprite pack</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.knockpack"/>
    <icon name="knock-desktop"/>
  </mime-type>
</mime-info>
