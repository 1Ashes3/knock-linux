{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "settings",
	"description": "The settings and setup window: settings, hook setup, health check, test knock and Repair (§8.5), settings-changed, and closing itself. Nothing else.",
	"windows": ["settings"],
	"permissions": [
		"core:event:allow-listen",
		"core:event:allow-unlisten",
		"core:window:allow-close",
		"allow-get-settings",
		"allow-update-settings",
		"allow-setup-status",
		"allow-setup-list-monitors",
		"allow-setup-preview-hooks",
		"allow-setup-apply-hooks",
		"allow-setup-remove-hooks",
		"allow-run-health-check",
		"allow-play-test-knock",
		"allow-repair-server"
	]
}
