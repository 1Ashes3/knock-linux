{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "strip",
	"description": "The strip: its §8.5 commands, and sessions-changed, away-summary and settings-changed. Nothing else from Tauri's core or plugins.",
	"windows": ["strip"],
	"permissions": [
		"core:event:allow-listen",
		"core:event:allow-unlisten",
		"allow-get-sessions",
		"allow-jump-to-session",
		"allow-acknowledge",
		"allow-dismiss",
		"allow-dismiss-away-summary",
		"allow-set-hit-regions",
		"allow-request-strip-size",
		"allow-get-settings",
		"allow-get-pack"
	]
}
